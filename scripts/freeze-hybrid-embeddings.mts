import { writeFileSync } from "node:fs";

import { benchmarkEmbeddingTexts, benchmarkFixture } from "../src/hybrid-retrieval.js";

const model = "nomic-embed-text";
const endpoint = process.env.NITELY_OLLAMA_BASE_URL ?? "http://127.0.0.1:11434";
const show = await fetch(new URL("/api/show", endpoint), {
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({ model }),
});
if (!show.ok) throw new Error(`ollama show failed with status ${show.status}`);
const described = await show.json() as { modelfile?: string };
const source = described.modelfile?.match(/FROM\s+\S*sha256-([a-f0-9]{64})/u)?.[1];
if (!source) throw new Error("ollama model blob digest is missing");
const texts = [...new Set(benchmarkEmbeddingTexts(benchmarkFixture))].sort();
const embedded = await fetch(new URL("/api/embed", endpoint), {
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({ model, input: texts }),
});
if (!embedded.ok) throw new Error(`ollama embed failed with status ${embedded.status}`);
const payload = await embedded.json() as { embeddings?: number[][] };
if (!payload.embeddings || payload.embeddings.length !== texts.length) throw new Error("ollama embed count mismatch");
const encoded = new Map<string, string>();
for (const [index, text] of texts.entries()) {
  const values = payload.embeddings[index];
  if (!values || values.length !== 768 || values.some((value) => !Number.isFinite(value))) throw new Error("ollama embed vector is invalid");
  const bytes = Buffer.alloc(values.length * 4);
  const view = new DataView(bytes.buffer);
  for (let offset = 0; offset < values.length; offset += 1) view.setFloat32(offset * 4, values[offset]!, true);
  encoded.set(text, bytes.toString("base64"));
}
const body = [
  "// Generated by scripts/freeze-hybrid-embeddings.mts. Replay only; do not hand-edit vectors.",
  `export const FROZEN_SEMANTIC_MODEL = ${JSON.stringify(model)};`,
  `export const FROZEN_SEMANTIC_SOURCE_DIGEST = ${JSON.stringify(`sha256:${source}`)};`,
  "export const FROZEN_SEMANTIC_DIMENSIONS = 768;",
  "export const FROZEN_SEMANTIC_VECTORS: Readonly<Record<string, string>> = {",
  ...[...encoded].map(([text, vector]) => `  ${JSON.stringify(text)}: ${JSON.stringify(vector)},`),
  "};",
  "",
].join("\n");
writeFileSync(new URL("../src/knowledge-repositories/frozen-semantic-table.ts", import.meta.url), body);
writeFileSync(new URL("../benchmarks/hybrid-retrieval.fixture.json", import.meta.url), `${JSON.stringify(benchmarkFixture, null, 2)}\n`);
console.log(`froze ${encoded.size} vectors from ${model} sha256:${source}`);
