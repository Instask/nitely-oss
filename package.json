{
  "name": "nitely",
  "version": "0.1.0",
  "description": "Local-first AI development workflow runtime for specs, flows, evidence, and runner-control-plane protocol contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "ai",
    "agent",
    "developer-tools",
    "workflow",
    "runner",
    "control-plane"
  ],
  "homepage": "https://github.com/Instask/nitely-oss#readme",
  "bugs": {
    "url": "https://github.com/Instask/nitely-oss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Instask/nitely-oss.git"
  },
  "bin": {
    "nitely": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./runner-control-plane/file-stub": {
      "types": "./dist/runner-control-plane/file-stub.d.ts",
      "default": "./dist/runner-control-plane/file-stub.js"
    },
    "./runner-control-plane/protocol": {
      "types": "./dist/runner-control-plane/protocol.d.ts",
      "default": "./dist/runner-control-plane/protocol.js"
    }
  },
  "files": [
    "dist/",
    "src/web/static/",
    "flows/",
    "docs/",
    "README.zh-CN.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.7",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "prepack": "npm run clean && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:robustness": "vitest run test/run/robustness.test.ts",
    "test:web-mobile": "vitest run test/web/mobile-viewport.test.ts"
  },
  "dependencies": {
    "@babel/standalone": "7.26.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "playwright-core": "^1.61.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
